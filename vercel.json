{
  "buildCommand": "flutter build web --release",
  "outputDirectory": "build/web",
  "framework": "flutter",
  "installCommand": "flutter pub get",
  "trailingSlash": false,
  "comment": "规范 URL 一律无 .html 后缀、无结尾斜杠；旧地址 301 到规范地址（与 nginx.conf 保持一致）",
  "redirects": [
    { "source": "/landing.html", "destination": "/en", "permanent": true },
    { "source": "/landing-jp.html", "destination": "/ja", "permanent": true },
    { "source": "/landing-kr.html", "destination": "/ko", "permanent": true },
    { "source": "/landing-th.html", "destination": "/th", "permanent": true },
    { "source": "/landing-vi.html", "destination": "/vi", "permanent": true },
    { "source": "/landing-de.html", "destination": "/de", "permanent": true },
    { "source": "/zh-tw.html", "destination": "/zh-tw", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/download.html", "destination": "/download", "permanent": true },
    { "source": "/promo.html", "destination": "/promo", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/data-deletion.html", "destination": "/data-deletion", "permanent": true },
    { "source": "/blog/rules-zh.html", "destination": "/blog/rules-zh", "permanent": true },
    { "source": "/blog/getting-started-guide.html", "destination": "/blog/getting-started-guide", "permanent": true },
    { "source": "/blog/seven-schools-guide.html", "destination": "/blog/seven-schools-guide", "permanent": true },
    { "source": "/landing", "destination": "/en", "permanent": true }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/landing.html" },
    { "source": "/ja", "destination": "/landing-jp.html" },
    { "source": "/ko", "destination": "/landing-kr.html" },
    { "source": "/th", "destination": "/landing-th.html" },
    { "source": "/vi", "destination": "/landing-vi.html" },
    { "source": "/de", "destination": "/landing-de.html" },
    { "source": "/zh-tw", "destination": "/zh-tw.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/promo", "destination": "/promo.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/data-deletion", "destination": "/data-deletion.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/rules-zh", "destination": "/blog/rules-zh.html" },
    { "source": "/blog/getting-started-guide", "destination": "/blog/getting-started-guide.html" },
    { "source": "/blog/seven-schools-guide", "destination": "/blog/seven-schools-guide.html" }
  ]
}
